# Local development only. Copy to .env (cp .env.example .env). Never commit .env.
DATABASE_URL=postgresql://potlock:potlock@localhost:5432/potlock?schema=public
# Used by `pnpm test` for ledger integration tests (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://potlock:potlock@localhost:5432/potlock_test?schema=public
REDIS_URL=redis://localhost:6379

# NextAuth session signing. Replace with `openssl rand -base64 32` output.
NEXTAUTH_SECRET=dev-only-change-me-nextauth
NEXTAUTH_URL=http://localhost:3000

# Shared between apps/web (signs) and services/match (verifies) match tokens.
MATCH_TOKEN_SECRET=dev-only-change-me-match-token

# Where things listen.
MATCH_PORT=2567
MATCH_HTTP_URL=http://localhost:2567
NEXT_PUBLIC_GAME_URL=http://localhost:5173
VITE_MATCH_WS_URL=ws://localhost:2567
VITE_LOBBY_URL=http://localhost:3000
